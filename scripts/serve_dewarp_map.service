# systemd --user unit for serve_dewarp_map.py (operator UI as user claw)
#
# Prerequisites:
#   pip install -e '.[viz]'   # panel, holoviews, bokeh, param in the ExecStart Python
#   mnc + etcd3 on that env if using live beam pointings (omit for --demo-pointings)
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp scripts/serve_dewarp_map.service ~/.config/systemd/user/
#   # edit WarpPath / FrequencyMHz / Port below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now serve_dewarp_map.service
#   journalctl --user -u serve_dewarp_map -f
#
# Then open http://127.0.0.1:5007/
#
# Linger (optional, survive logout):
#   loginctl enable-linger claw
#
# Notes:
#   - Prefer an explicit --warp-path so the UI keeps working if tip-tilt etcd TTL expires.
#   - Beam marks need /mon/beamformer/{N}/pointing from mnc publish_commanded_pointing.
#   - Bind stays on 127.0.0.1; use SSH tunnel or a reverse proxy for remote access.

[Unit]
Description=Live tip-tilt / dewarp map Panel app
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/claw/code/image-plane-correction
Environment=PYTHONPATH=/home/claw/code/image-plane-correction/src
Environment=PATH=/opt/devel/claw/envs/py312/bin:/usr/bin
ExecStart=/opt/devel/claw/envs/py312/bin/python \
  /home/claw/code/image-plane-correction/scripts/serve_dewarp_map.py \
  --warp-path /fast/claw/warps/warp_55MHz.npz \
  --frequency-mhz 55 \
  --poll-seconds 3 \
  --port 5007 \
  --address 127.0.0.1
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
